# Server
PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=postgres://username:password@localhost:5432/fieldforce

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins.
# Since there is no domain yet, this is the frontend's IP-based origin, e.g. http://203.0.113.10
# Update this one line when a domain is added later - nothing else in the code changes.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Microsoft 365 integration (Outlook mail + Teams meetings) - optional, the
# app runs fine without these, the feature just shows as "not configured"
# until they're set. From the Azure/Entra app registration.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback
FRONTEND_URL=http://localhost:5173

# This server's own public address (no path) - needed so K3 can fetch back a
# WhatsApp attachment we're sending it a link to.
PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# SSO - FieldForce as the identity provider for Frappe Helpdesk's "Social
# Login Key" (provider: Custom). CLIENT_ID/SECRET are generated by us and
# pasted into that Social Login Key's Client ID/Client Secret fields.
# REDIRECT_URI is the exact callback URL Frappe computes from that key's
# name - see docs.frappe.io/framework/.../adding-social-login-provider.
SSO_FRAPPE_CLIENT_ID=
SSO_FRAPPE_CLIENT_SECRET=
SSO_FRAPPE_REDIRECT_URI=
SSO_TOKEN_SECRET=change-this-to-a-long-random-string
